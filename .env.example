# with a placeholder value/comment, kept accurate by whichever plan
# introduces it (structure only — Plan 02 owns the real contract and
# per-environment behavior). Copy to .env.local and fill in real values;
# .env.local is gitignored and never committed.

# --- Shared ---
NODE_ENV=development

