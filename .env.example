# Every environment variable the system will ever need gets listed here
# with a placeholder value/comment, kept accurate by whichever plan
# introduces it. No real secrets ever committed to this file.
#
# Local dev: copy this to .env.local (gitignored) and fill in real values —
# see the root README.
# Test/Production: create a file named .env directly on that host (never
# committed) with that host's real secrets — see
# docs/deployment-runbook.md. Every environment has fully separate
# Postgres, Redis, and uploads; never point one environment's config at
# another's data.
#
# APP_ENV vs NODE_ENV: APP_ENV (local|test|production) is this project's
# own environment discriminator — app code should branch on this, never on
# NODE_ENV alone. NODE_ENV controls Node/Next.js's own dev-vs-production
# behavior and is set automatically by each Docker image target
# (docker/*.Dockerfile) — you don't need to set it by hand.

# --- App identity ---
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- apps/api ---
# Port apps/api actually binds to (see apps/api/src/main.ts) — distinct
# from API_URL above, which is the address other services/clients use to
# reach it. Next.js also honors PORT for apps/web, so docker-compose.yml
# pins web's PORT to 3000 explicitly — don't remove that override, or web
# silently inherits this value too.
PORT=3001
# apps/api and apps/worker have no Next.js-style auto-loading of their own —
# their `dev` scripts load this file explicitly via `dotenv-cli` (see
# apps/api/package.json). `start` (used only inside the Docker images) needs
# no such loading: docker-compose's `env_file: .env` already injects these
# into the container's process.env directly.

# --- Swagger UI (Test only — see apps/api/src/swagger.ts) ---
# Local mounts /api/docs with no auth; Production doesn't mount it at all.
# Real credentials live only in Test's untracked .env.
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Database & cache ---
# DATABASE_URL/REDIS_URL hostnames depend on how you're running things:
#   - Hybrid local (recommended, `pnpm dev`, Postgres/Redis in Docker only):
#     `localhost`, as below.
#   - Full Docker local (docker-compose.local.yml), Test, and Production:
#     the service names instead — postgresql://user:pass@postgres:5432/...
#     and redis://redis:6379.
# POSTGRES_USER/PASSWORD/DB initialize the postgres container itself and
# must match the credentials embedded in DATABASE_URL.
DATABASE_URL=postgresql://user:pass@localhost:5432/marketplace
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=marketplace
REDIS_URL=redis://localhost:6379

# --- Storage ---
# UPLOAD_ROOT is /data/uploads on Test/Production (see the /data layout in
# docs/deployment-runbook.md); a project-relative path locally.
UPLOAD_ROOT=./.data/uploads
PUBLIC_UPLOAD_URL=http://localhost:3001/uploads

# --- Auth (Plan 07) ---
# Better Auth's session/cookie-signing secret — required, no safe default.
# Generate a real one per environment with `openssl rand -base64 32`; never
# reuse Local's value in Test/Production.
AUTH_SECRET=

# Google OAuth (Plan 07 §11.3) — prep only, deliberately left blank until a
# real Google Cloud OAuth app exists (setup step, once ready):
#   1. console.cloud.google.com -> APIs & Services -> Credentials -> Create
#      Credentials -> OAuth client ID -> "Web application".
#   2. Authorized redirect URI: <API_URL>/api/v1/auth/callback/google
#      (Local: http://localhost:3001/api/v1/auth/callback/google).
#   3. Copy the generated client ID/secret in here (or Test/Production's
#      untracked .env). Leaving these blank is a safe no-op — the `google`
#      social provider is only registered when both are set (see
#      apps/api/src/modules/auth/auth-instance.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email — SMTP (Plan 07 §11.1) ---
# Prep only: real values come later (setup step, once ready):
#   1. Pick an SMTP provider/relay (a real mailbox, or a transactional-email
#      provider's SMTP endpoint) and create credentials.
#   2. Fill in SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD/SMTP_SECURE below
#      (or Test/Production's untracked .env) and set EMAIL_FROM to a real
#      sending address on that domain.
# Leaving SMTP_HOST blank is a safe no-op — EmailService logs the email
# instead of sending it (see
# apps/api/src/modules/auth/email/email.service.ts), so registration/
# password-reset flows still work end-to-end locally without real SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=Vehicles Marketplace <no-reply@example.co.uk>

# --- External services (real values defined in the plan that first uses each) ---
AI_API_KEY=
DVLA_API_KEY=

# --- Public API base URL (Plan 07) ---
# Read by apps/web (Next.js inlines NEXT_PUBLIC_* at build time) and
# apps/mobile (Expo inlines EXPO_PUBLIC_* at bundle time) to build the
# Better Auth client — see apps/web/app/_lib/auth-client.ts and
# apps/mobile/lib/auth-client.ts. Both apps' `dev`/`build`/`start` scripts
# load this file the same way apps/api's already did (Plan 05) — see the
# comment there.
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
