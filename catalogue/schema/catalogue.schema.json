            "MANUFACTURER_COLOUR"
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "entityType", "entityId", "alias"]
