{
  "name": "@vehicles-marketplace/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- node --watch -r ts-node/register src/main.ts",
    "start": "node -r ts-node/register src/main.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:openapi": "dotenv -e ../../.env.local -- node -r ts-node/register scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/throttler": "6.5.0",
    "@vehicles-marketplace/config": "workspace:*",
    "@vehicles-marketplace/validation": "workspace:*",
    "express-basic-auth": "1.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.1.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@vehicles-marketplace/eslint-config": "workspace:*",
    "@vehicles-marketplace/tsconfig": "workspace:*",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  }
