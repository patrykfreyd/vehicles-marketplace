{
  "name": "@vehicles-marketplace/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@vehicles-marketplace/validation": "workspace:*",
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-status-bar": "57.0.1",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@react-native/assets-registry": "0.87.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@vehicles-marketplace/eslint-config": "workspace:*",
    "@vehicles-marketplace/tsconfig": "workspace:*",
    "babel-preset-expo": "57.0.11",
    "eslint": "9.39.5",
    "jest": "30.5.1",
    "jest-expo": "57.0.5",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
