{
  "name": "vehicles-marketplace",
  "version": "0.0.0",
  "private": true,
  "description": "Vehicles marketplace monorepo — web, mobile, api, worker, catalogue-cli.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate:openapi": "pnpm --filter @vehicles-marketplace/api generate:openapi",
    "generate:api-client": "pnpm generate:openapi && pnpm --filter @vehicles-marketplace/api-client generate:api-client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@vehicles-marketplace/eslint-config": "workspace:*",
    "@vehicles-marketplace/prettier-config": "workspace:*",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "prettier": "@vehicles-marketplace/prettier-config",
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,cjs,mjs,ts,tsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
