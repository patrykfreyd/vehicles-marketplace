    "@vehicles-marketplace/eslint-config": "workspace:*",
    "@vehicles-marketplace/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  }
