// Plan 08 (Catalogue Data Model & JSON Schema) — the Make -> Model ->
// Generation -> Derivative hierarchy plus the controlled-value/alias/
// data-quality machinery it needs. See plans/08-catalogue-data-model-json-schema.md
// §5 for the design this file implements close to verbatim.
//
// `Fuel`/`Transmission`/`Drivetrain`/`BodyStyle` mirror the Zod enums
// already defined in packages/validation/src/enums (Plan 03 §7) — this is
// the first plan that needs them as real Postgres enum columns, so it
// defines the Prisma-level enum here, kept value-for-value identical to
// the Zod source of truth.
enum Fuel {
  PETROL
  DIESEL
  HYBRID
  PHEV
  ELECTRIC
  HYDROGEN
}

enum Transmission {
  MANUAL
  AUTOMATIC
  DCT
  CVT
}

enum Drivetrain {
  FWD
  RWD
  AWD
}

enum BodyStyle {
  HATCHBACK
  SALOON
  ESTATE
  COUPE
  CONVERTIBLE
  SUV
  MPV
  PICKUP
}

// Catalogue-specific enums added by this plan (§4).
enum EngineConfiguration {
  INLINE_3
  INLINE_4
  INLINE_5
  INLINE_6
  V6
  V8
  V10
  V12
  FLAT_4
  FLAT_6
  ELECTRIC_MOTOR
}

enum Aspiration {
  NATURALLY_ASPIRATED
  TURBO
  TWIN_TURBO
  SUPERCHARGED
  ELECTRIC
}

enum ColourFamily {
  BLACK
  WHITE
  BLUE
  RED
  GREEN
  GREY
  SILVER
  YELLOW
  ORANGE
  PURPLE
  BROWN
  BEIGE
}

enum CatalogueStatus {
  IMPORTED
  AI_DRAFT
  REVIEW_REQUIRED
  SOURCE_CONFIRMED
  APPROVED
  DEPRECATED
}

enum CatalogueEntityType {
  MAKE
  MODEL
  GENERATION
  DERIVATIVE
  ENGINE_FAMILY
  MANUFACTURER_COLOUR
}

// Plan 09 (Catalogue Import Tooling & Admin) §4 — audit trail for imports
// and the review queue the Catalogue Admin (§7) reads from.
enum IssueSeverity {
  WARNING
  ERROR
}

// Catalogue entities use stable, human-readable slug IDs, not prefixed
// ULIDs — see plans/03-shared-types-validation.md §5: curated, low-volume,
// and the slug itself is useful in URLs/logs (idea doc §29).
model Make {
  id   String @id // slug, e.g. "bmw"
  name String

  models  Model[]
  colours ManufacturerColour[]

  @@map("makes")
}

model Model {
  id     String @id // slug, e.g. "bmw-m4"
  makeId String @map("make_id")
  make   Make   @relation(fields: [makeId], references: [id])
  name   String

  generations Generation[]

  @@index([makeId])
  @@map("models")
}

model Generation {
  id                  String @id // slug, e.g. "bmw-m4-g82"
  modelId             String @map("model_id")
  model               Model  @relation(fields: [modelId], references: [id])
  code                String // "G82"
  productionStartYear Int    @map("production_start_year")
  productionEndYear   Int?   @map("production_end_year")

  derivatives Derivative[]

  @@index([modelId])
  @@map("generations")
}

model Derivative {
  id             String     @id // slug, e.g. "bmw-m4-g82-competition-xdrive"
  generationId   String     @map("generation_id")
  generation     Generation @relation(fields: [generationId], references: [id])
  name           String // "M4 Competition xDrive"
  specialEdition Boolean    @default(false) @map("special_edition")

  bodyStyle BodyStyle @map("body_style")
  doors     Int?
  seats     Int?

  fuel             Fuel
  engineCapacityCc Int?                 @map("engine_capacity_cc")
  cylinders        Int?
  configuration    EngineConfiguration?
  aspiration       Aspiration?
  engineFamily     String?              @map("engine_family") // "S58"
  powerBhp         Int?                 @map("power_bhp")
  torqueNm         Int?                 @map("torque_nm")

  // No `@default([])` in the plan's own §5 snippet, but added here so
  // rows can legitimately omit transmissions (the idea doc's own F82 "M4
  // Competition" worked example does exactly that — see §7/catalogue/bmw/m4.json)
  // without every insert having to pass an empty array explicitly.
  transmissions              Transmission[] @default([])
  drivetrain                 Drivetrain     @map("drivetrain")
  drivetrainManufacturerName String?        @map("drivetrain_manufacturer_name") // "M xDrive"

  zeroToSixtyTwoSeconds Float? @map("zero_to_sixty_two_seconds")
  topSpeedMph           Int?   @map("top_speed_mph")

  status            CatalogueStatus @default(AI_DRAFT)
  confidence        Float?
  reviewed          Boolean         @default(false)
  completenessScore Int             @default(0) @map("completeness_score")

  sources  DerivativeSource[]
  // plans/11-vehicle-listing-data-model.md §5 — the one link from a seller's
  // Vehicle back to the catalogue; only an `APPROVED` derivative is
  // referenceable (enforced in VehiclesService, not here).
  vehicles Vehicle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([generationId])
  @@map("derivatives")
}

model ManufacturerColour {
  id        String       @id
  makeId    String       @map("make_id")
  make      Make         @relation(fields: [makeId], references: [id])
  name      String // "Marina Bay Blue Metallic"
  family    ColourFamily
  paintCode String?      @map("paint_code") // "C1K"

  // plans/11-vehicle-listing-data-model.md §5 — a seller can declare their
  // Vehicle's exact factory paint against this table.
  vehicles Vehicle[]

  @@index([makeId])
  @@map("manufacturer_colours")
}

model Equipment {
  id       String @id // "carbon_bucket_seats"
  name     String // canonical display name
  category String

  manufacturerAliases ManufacturerEquipmentAlias[]
  // plans/11-vehicle-listing-data-model.md §5 — vehicle-level only, no
  // catalogue-to-derivative equipment link (confirmed in Plan 08 §5).
  vehicleLinks        VehicleEquipment[]

  @@map("equipment")
}

model ManufacturerEquipmentAlias {
  id               String    @id
  equipmentId      String    @map("equipment_id")
  equipment        Equipment @relation(fields: [equipmentId], references: [id])
  makeId           String    @map("make_id")
  manufacturerName String    @map("manufacturer_name") // "M Carbon Bucket Seats"

  @@index([equipmentId])
  @@map("manufacturer_equipment_aliases")
}

model CatalogueAlias {
  id         String              @id
  entityType CatalogueEntityType @map("entity_type")
  entityId   String              @map("entity_id")
  alias      String

  @@index([entityType, entityId])
  @@index([alias])
  @@map("catalogue_aliases")
}

// --- Plan 09 (Catalogue Import Tooling & Admin) §4 ---
// Audit trail for `catalogue import` runs plus the Admin's review queue
// (§7): the CLI's console output alone isn't enough for a reviewer working
// the Admin UI days after an import ran.

model CatalogueSource {
  id          String   @id
  name        String // "BMW UK press pack 2023"
  url         String?
  licenseNote String?  @map("license_note")
  createdAt   DateTime @default(now()) @map("created_at")

  derivatives DerivativeSource[]

  @@map("catalogue_sources")
}

// §4's own CatalogueSource snippet has no relation to a Derivative — that
// table is a reusable pool of sources ("BMW UK press pack 2023" can back
// several derivatives), not a per-derivative attachment. §7 needs "source
// attachment" per derivative and §6's REVIEW_REQUIRED -> SOURCE_CONFIRMED
// transition fires when "admin attaches a CatalogueSource" to one — neither
// is possible without a join, so this many-to-many table is added beyond
// §4's literal snippet to make that concrete.
model DerivativeSource {
  id           String          @id
  derivativeId String          @map("derivative_id")
  derivative   Derivative      @relation(fields: [derivativeId], references: [id])
  sourceId     String          @map("source_id")
  source       CatalogueSource @relation(fields: [sourceId], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([derivativeId, sourceId])
  @@index([derivativeId])
  @@map("derivative_sources")
}

model CatalogueImport {
  id             String   @id
  manufacturerId String   @map("manufacturer_id")
  filePath       String   @map("file_path")
  importedBy     String?  @map("imported_by") // User.id, nullable for CLI-only runs
  recordsCreated Int      @map("records_created")
  recordsUpdated Int      @map("records_updated")
  warningsCount  Int      @map("warnings_count")
  errorsCount    Int      @map("errors_count")
  createdAt      DateTime @default(now()) @map("created_at")

  issues CatalogueValidationIssue[]

  @@index([manufacturerId])
  @@map("catalogue_imports")
}

model CatalogueValidationIssue {
  id         String              @id
  importId   String              @map("import_id")
  import     CatalogueImport     @relation(fields: [importId], references: [id])
  entityType CatalogueEntityType @map("entity_type")
  entityId   String              @map("entity_id")
  severity   IssueSeverity
  message    String // "G82 M4 CS missing torque"
  resolved   Boolean             @default(false)
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([resolved])
  @@map("catalogue_validation_issues")
}
