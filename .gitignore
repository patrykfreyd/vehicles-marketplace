# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
.expo/
.expo-shared/
*.tsbuildinfo

# Generated OpenAPI spec (apps/api/scripts/generate-openapi.ts) — a pure
# intermediate artifact for packages/api-client's codegen step; the
# generated *client* it feeds (packages/api-client/src/generated) IS
# committed, since apps consume it with no build step.
/apps/api/openapi.json

# Env
.env
.env.local
.env.*.local

# Local Docker data dir (docker-compose.local.yml) — Postgres/uploads bind
# mounts for local dev; never anything to commit here
.data/

# Test / coverage
coverage/

# Logs
*.log
pnpm-debug.log*
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
Thumbs.db
